# Stripe webhook service. Build/run:
#   docker build -f Dockerfile.webhook -t shopee-webhook .
#   docker run -p 8000:8000 --env-file webhook.env shopee-webhook
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements-webhook.txt .
RUN pip install -r requirements-webhook.txt

COPY webhook_server.py .

# Do not run as root.
RUN useradd --create-home appuser
USER appuser

EXPOSE 8000
# Hosts like Render/Railway/Fly/Cloud Run inject $PORT; default to 8000 locally.
CMD ["sh", "-c", "uvicorn webhook_server:create_app --factory --host 0.0.0.0 --port ${PORT:-8000}"]
